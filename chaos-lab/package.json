{
  "name": "fux-chaos-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive browser prototype of FuX, the reactive ferrofluid entity from the Magic Mirror Box UE5 build kit.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:glsl": "node tools/glsl-lint.mjs",
    "body:report": "node tools/body-shape-report.mjs",
    "docs:build-kit": "node tools/build-kit-to-markdown.mjs",
    "verify": "npm run lint:glsl && npm run docs:build-kit -- --check && npm run docs:moods -- --check && npm run test",
    "bridge": "node tools/bridge-demo.mjs",
    "docs:moods": "node tools/moods-to-csv.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@shaderfrog/glsl-parser": "^7.0.1",
    "jsdom": "^30.1.0",
    "pdfjs-dist": "^6.3.289",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18"
  }
}
